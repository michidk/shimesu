{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>michidk/workflows//templates/presets/renovate",
    ":enableVulnerabilityAlertsWithLabel('security')"
  ],
  "labels": [
    "no-stale",
    "bot"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Cargo dependencies",
      "groupSlug": "cargo-deps",
      "rangeStrategy": "pin"
    }
  ]
}
